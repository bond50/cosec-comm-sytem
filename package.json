{
  "name": "cosec-comm-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ts-check": "tsc --noEmit",
    "ts-watch": "tsc --noEmit --watch",
    "lint:ts": "eslint . --ext .ts,.tsx",
    "pretty": "prettier -w \"**/*.{ts,tsx,js,jsx,json,css,md,html}\"",
    "db:seed:county": "prisma db execute --file prisma/county-foundation-seed.sql",
    "db:reset:uat": "prisma migrate reset --force && pnpm run db:seed:county",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@marsidev/react-turnstile": "^1.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-email/components": "^0.5.7",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.541.0",
    "nanoid": "^5.1.6",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "rate-limiter-flexible": "^7.3.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "resend": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
